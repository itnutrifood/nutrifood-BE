APP_NAME=NutriFood
ENVIRONMENT=local
DEBUG=true
API_PREFIX=/api

POSTGRES_DB=nutrifood
POSTGRES_USER=nutrifood
POSTGRES_PASSWORD=nutrifood
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql://nutrifood:nutrifood@db:5432/nutrifood
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgresql://nutrifood:nutrifood@db:5432/nutrifood?sslmode=disable

ADMIN_USERNAME=admin@mail.com
ADMIN_PASSWORD=123456
ADMIN_TOKEN_SECRET=change-me-to-a-long-random-secret
ADMIN_TOKEN_ALGORITHM=HS256
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=15
ADMIN_REFRESH_TOKEN_EXPIRE_DAYS=7

USER_TOKEN_SECRET=change-me-to-a-different-long-random-secret
USER_TOKEN_ALGORITHM=HS256
USER_ACCESS_TOKEN_EXPIRE_MINUTES=15
USER_REFRESH_TOKEN_EXPIRE_DAYS=30

# Mount this file securely in production. When omitted, Google Application
# Default Credentials are used.
FIREBASE_CREDENTIALS_PATH=firebase.json
FIREBASE_PROJECT_ID=nutrifood-dev
