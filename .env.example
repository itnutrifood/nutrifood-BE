APP_NAME=NutriFood
ENVIRONMENT=local
DEBUG=true
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Daily application log files. Compose overrides LOG_DIRECTORY and LOG_COMPONENT
# for each service while preserving console output for `docker compose logs`.
LOG_DIRECTORY=logs
LOG_COMPONENT=api
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
LOG_ROTATION_UTC=true

POSTGRES_DB=nutrifood
POSTGRES_USER=nutrifood
POSTGRES_PASSWORD=nutrifood
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql://nutrifood:nutrifood@db:5432/nutrifood
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgresql://nutrifood:nutrifood@db:5432/nutrifood?sslmode=disable
CATALOG_CURRENCY=USD

# Redis DB 0 carries task messages; DB 1 stores short-lived task results; DB 2
# stores public statistics cached by the daily task and request fallback.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
STATISTICS_CACHE_URL=redis://redis:6379/2
CELERY_TIMEZONE=UTC
CELERY_RESULT_EXPIRES_SECONDS=604800
CELERY_WORKER_CONCURRENCY=2

ADMIN_USERNAME=admin@mail.com
ADMIN_PASSWORD=123456
ADMIN_TOKEN_SECRET=change-me-to-a-long-random-secret
ADMIN_TOKEN_ALGORITHM=HS256
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=15
ADMIN_REFRESH_TOKEN_EXPIRE_DAYS=7

# Mount this file securely in production. When omitted, Google Application
# Default Credentials are used.
FIREBASE_CREDENTIALS_PATH=firebase.json
FIREBASE_PROJECT_ID=nutrifood-dev
FIREBASE_REQUIRE_VERIFIED_EMAIL=true
FIREBASE_ALLOWED_SIGN_IN_PROVIDERS=["password","google.com"]
FCM_REGISTRATION_STALE_DAYS=30

# SendGrid API key with Mail Send permission and a verified sender address.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Cloudflare R2 S3 API credentials. Scope the token to Object Read & Write for
# this bucket only. Use an R2 custom domain for the public base URL in production.
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nutrifood-assets
R2_PUBLIC_BASE_URL=https://assets.example.com
R2_UPLOAD_URL_EXPIRE_SECONDS=900
